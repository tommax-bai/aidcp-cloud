# aidcp-cloud automation 服务（Block② 2e 一机多服务拆分）
#
# 段：segA(基础) + segC(automation)。跳过 segB(content) / segD(api serving)。
# 承载：边缘 WebSocket server、风控、事件驱动编排、通知巡视（边-云浏览闭环）。
# 监听：0.0.0.0:${AIDCP_PORT}（默认 8787，对外 edge 直连口，与单体一致）。
#
# ── 前置依赖（runtime split 工作线负责，非本部署件） ──────────────────────────
#   AIDCP_SERVICE=automation 是**目标态**取值。当前 src/gateway/service-mode.ts 只识别
#   content / core / monolith —— 未识别值一律回落 monolith（会跑全部四段、抢 8787 与 panel/
#   client-auth 端口）。因此：本单元必须待 service-mode 的选择器识别 'automation'（segA+segC）
#   且 segC 可脱离 segD 独立 boot 后才可上线。deploy-multi.sh 会在切 3-service 前做能力探测
#   （grep service-mode.ts 是否含 automation 分支），未满足即拒绝切换、保持单体不停机。
#   在此之前，可用的非单体拓扑是 2-service：content + core（见 aidcp-cloud-core.service）。
#
# ── 数据网关 ────────────────────────────────────────────────────────────────
#   数据网关（DataGateway，curated 读端口 remote 到 content 进程）在 **segD** 内构造。
#   automation 只跑 segC、不构造网关，故本单元**不设** AIDCP_GATEWAY_MODE / _BASE_URL。
#   TODO(confirm-with-runtime-split)：若拆分后 automation 侧角色（如精选准入评估）需跨进程
#   读 content，需由 runtime split 工作线在 segC 内接入网关，并在此追加：
#     Environment=AIDCP_GATEWAY_MODE=http
#     Environment=AIDCP_GATEWAY_BASE_URL=http://127.0.0.1:8092
#
# ── isales 红线 ─────────────────────────────────────────────────────────────
#   8787 为 aidcp 现役对外口，与 isales（80 / 8000）零重叠。绝不 touch isales。

[Unit]
Description=aidcp-cloud automation (multi-service split, AIDCP_SERVICE=automation, edge WS :8787)
Documentation=file:///opt/aidcp/cloud/deploy/multi-service/README.md
After=network-online.target aidcp-cloud-content.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/aidcp/cloud
EnvironmentFile=/opt/aidcp/cloud/.env
Environment=AIDCP_SERVICE=automation
# 边缘 WS 对外口，与单体一致（.env 通常已含同值，此处显式钉牢）。
Environment=AIDCP_PORT=8787
ExecStart=/usr/bin/npx tsx src/server.ts
Restart=always
RestartSec=5
# NOTE(confirm-with-current)：User 处理同 content 单元（推定 root，需与现役单元核对）。

[Install]
WantedBy=multi-user.target
