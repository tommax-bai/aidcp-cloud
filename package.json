{
  "name": "aidcp-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "AIDCP 云端：任务规划（planner）+ 文本 LLM（Qwen HTTP）+ 锚点缓存（PostgreSQL）+ 边-云通信（WebSocket 服务端）+ 点赞命令下发。",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test 'test/**/*.test.ts'",
    "test:acceptance": "tsx --test test/acceptance/*.test.ts",
    "test:pg": "AIDCP_PG_INTEGRATION=1 tsx --test --test-concurrency=1 'test/**/*.integration.test.ts'"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.66.0",
    "@resvg/resvg-js": "2.6.2",
    "ali-oss": "^6.23.0",
    "pg": "^8.13.1",
    "satori": "0.26.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
